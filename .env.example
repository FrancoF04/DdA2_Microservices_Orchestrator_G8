#---app---#
PORT=8080
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

#---servicios destino (URL base, sin el recurso)---#
LEADS_URL=http://localhost:8000
CLIENTES_URL=http://localhost:8082
VEHICULOS_URL=http://localhost:8083
CALIFICACION_URL=http://localhost:8084
MONITOR_URL=http://localhost:8085
# ia-resumen no fija puerto (en Render usa $PORT; en local uvicorn usa 8000 y choca con leads)
IA_RESUMEN_URL=http://localhost:8001
AUTH_URL=
MULTAS_URL=
# Espera máxima de la respuesta del servicio. En Render (free) usar 60: un servicio dormido tarda ~1 min.
PROXY_TIMEOUT_SEGUNDOS=30
PROXY_TIMEOUT_CONEXION_SEGUNDOS=10
# Reintentos ante falla de conexión, solo en GET/HEAD/OPTIONS.
PROXY_REINTENTOS_GET=1
# De qué proxies aceptar X-Forwarded-*. En Render: *
FORWARDED_ALLOW_IPS=127.0.0.1

#---autenticación (ver docs/06-autenticacion.md)---#
# Habilitada por defecto: el orquestador NO arranca sin JWT_SECRET. Solo apagarla en desarrollo.
AUTH_HABILITADA=true
# El mismo JWT_SECRET que usa AuthMicroservice (HS256). 32+ caracteres: openssl rand -base64 48
JWT_SECRET=
JWT_ALGORITHM=HS256
# Credenciales de los servicios que llaman a otros por el orquestador, "servicio=clave,servicio=clave".
# Servicios válidos: leads, calificacion, ia-resumen. Cada clave: 32+ caracteres y distinta.
# Cada servicio manda la suya en X-Clave-Servicio (y su nombre en X-Origen-Servicio).
CLAVES_SERVICIO=

#---base de datos (Supabase, session pooler puerto 5432)---#
# Vacía = el orquestador corre sin base (solo para pruebas).
# Supabase: postgresql://orquestador_app.<project-ref>:<clave>@<host-pooler>:5432/postgres?sslmode=require
# docker compose local: la pisa el compose (postgres del contenedor).
DATABASE_URL=
DB_SCHEMA=orquestador
DB_POOL_SIZE=3
# Correr `alembic upgrade head` al iniciar el contenedor.
MIGRAR_AL_INICIAR=true

#---kafka---#
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=orquestador
KAFKA_CLIENT_ID=orquestador
# Aiven: SASL_SSL + mecanismo a confirmar (PLAIN o SCRAM-SHA-256) + KAFKA_SSL_CAFILE=ca.pem
# Kafka local: dejar vacías.
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_REINTENTO_CONEXION_SEGUNDOS=15

#---orquestación---#
# Los tres tópicos del ecosistema (docs/08-contrato-tres-topicos.md). Los crea el orquestador al arrancar.
KAFKA_TOPICO_COMANDOS=crm.comandos
KAFKA_TOPICO_EVENTOS=crm.eventos
KAFKA_TOPICO_DLT=crm.dlt
# Intentos de publicar un comando (tras el último el flujo queda FALLIDO o el paso con error) y espera
# entre intentos (base * 2^(intento-1), con tope).
OUTBOX_MAX_INTENTOS=5
OUTBOX_ESPERA_BASE_SEGUNDOS=5
OUTBOX_ESPERA_MAXIMA_SEGUNDOS=300
OUTBOX_INTERVALO_SEGUNDOS=2

#---flujos---#
# Tiempo máximo de cada paso antes de marcar el flujo como EXPIRADO.
FLUJO_TIMEOUT_CALIFICACION_SEGUNDOS=120
FLUJO_TIMEOUT_RESUMEN_SEGUNDOS=300
# Cada cuánto se buscan flujos vencidos.
FLUJO_INTERVALO_VENCIMIENTO_SEGUNDOS=15
AUDITORIA_RETENCION_DIAS=7
# Días que se conservan las filas resueltas del outbox y los eventos procesados (más que la retención de Kafka).
RETENCION_HISTORIAL_DIAS=30

#---multas---#
# Plazo del scraper para responder.
FLUJO_TIMEOUT_MULTAS_SEGUNDOS=300
# Consultas por unidad antes de dejar el flujo FALLIDO y espera entre ellas (base * 2^(reintento-1)).
MULTAS_MAX_INTENTOS=3
MULTAS_ESPERA_BASE_SEGUNDOS=60
# Barrido de las unidades disponibles: activarlo cuando vehiculos tenga `patente`.
MULTAS_BARRIDO_HABILITADO=false
# Que el alta de una unidad (POST /api/vehiculos) abra su consulta de multas: activarlo junto con el barrido.
MULTAS_AL_ALTA=false
MULTAS_BARRIDO_INTERVALO_SEGUNDOS=86400
MULTAS_BARRIDO_MAXIMO=50
# Clave de escritura de vehiculos (X-Api-Key) para entregarle el resultado de las multas.
VEHICULOS_API_KEY=
